/boot          emmc  /dev/block/bootdevice/by-name/boot       flags=display="Boot";backup=1;flashimg=1
/dtbo          emmc  /dev/block/bootdevice/by-name/dtbo       flags=display="DTBO";backup=1;flashimg=1
/recovery      emmc  /dev/block/bootdevice/by-name/recovery   flags=display="Recovery";backup=1;flashimg=1

/cache         ext4  /dev/block/bootdevice/by-name/cache      flags=display="Cache";backup=1;wipeingui
/dsp           emmc  /dev/block/bootdevice/by-name/dsp        flags=display="DSP";backup=1
/efs           ext4  /dev/block/bootdevice/by-name/efs        flags=display="EFS";backup=1
/sec_efs       ext4  /dev/block/bootdevice/by-name/sec_efs    flags=display="Sec EFS";backup=1
/mdm           emmc  /dev/block/bootdevice/by-name/modem      flags=display="MDM";backup=1
/metadata      ext4  /dev/block/bootdevice/by-name/metadata   flags=display="Metadata";backup=1;wipeingui
/misc          emmc  /dev/block/bootdevice/by-name/misc       flags=display="Misc";backup=1
/modem         emmc  /dev/block/bootdevice/by-name/apnhlos    flags=display="Modem";backup=1
/optics        ext4  /dev/block/bootdevice/by-name/optics     flags=display="Optics";backup=1;wipeingui
/prism         ext4  /dev/block/bootdevice/by-name/prism      flags=display="Prism";backup=1;wipeingui

/data          f2fs  /dev/block/bootdevice/by-name/userdata   flags=display="Data";backup=1;wipeingui

/external_sd	vfat	/dev/block/mmcblk0p1	/dev/block/mmcblk0		flags=display="External SD";storage;wipeingui;removable
/usb-otg		auto	/dev/block/sde1	        /dev/block/sde			flags=display="USB-OTG";storage;wipeingui;removable