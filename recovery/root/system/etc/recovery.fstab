# Android fstab file.
# The filesystem that contains the filesystem checker binary (typically /system) cannot
# specify MF_CHECK, and must come before any filesystems that do specify MF_CHECK

#TODO: Add 'check' as fs_mgr_flags with data partition.
# Currently we dont have e2fsck compiled. So fs check would failed.

#<src>                                                 <mnt_point>               <type>  <mnt_flags and options>                            <fs_mgr_flags>
system                                     /system         ext4    ro,barrier=1,discard                                                                                wait,logical,first_stage_mount
system                                     /system         erofs   ro                                                                                                  wait,logical,first_stage_mount
vendor                                     /vendor         ext4    ro,barrier=1,discard                                                                                wait,logical,first_stage_mount
vendor                                     /vendor         erofs   ro                                                                                                  wait,logical,first_stage_mount
product                                    /product        ext4    ro,barrier=1,discard                                                                                wait,logical,first_stage_mount
product                                    /product        erofs   ro                                                                                                  wait,logical,first_stage_mount
odm                                        /odm            ext4    ro,barrier=1,discard                                                                                wait,logical,first_stage_mount
odm                                        /odm            erofs   ro                                                                                                  wait,logical,first_stage_mount

/dev/block/bootdevice/by-name/userdata     /data           f2fs    noatime,nosuid,nodev,discard,usrquota,grpquota,fsync_mode=nobarrier,reserve_root=32768,resgid=5678  wait
/dev/block/bootdevice/by-name/misc         /misc           emmc    defaults                                                                                            defaults


/dev/block/bootdevice/by-name/boot       /boot       emmc    defaults    defaults
/dev/block/bootdevice/by-name/recovery   /recovery   emmc    defaults    defaults
/dev/block/bootdevice/by-name/metadata   /metadata   ext4    defaults    defaults
/dev/block/bootdevice/by-name/cache      /cache      ext4    defaults    defaults
/dev/block/bootdevice/by-name/efs        /efs        ext4    defaults    defaults
/dev/block/bootdevice/by-name/sec_efs    /sec_efs    ext4    defaults    defaults
/dev/block/bootdevice/by-name/apnhlos    /modem      emmc    defaults    defaults
/dev/block/bootdevice/by-name/modem      /mdm        emmc    defaults    defaults
/dev/block/bootdevice/by-name/dsp        /dsp        emmc    defaults    defaults
/dev/block/bootdevice/by-name/dtbo       /dtbo       emmc    defaults    defaults
/dev/block/bootdevice/by-name/prism      /prism      ext4    defaults    defaults
/dev/block/bootdevice/by-name/optics     /optics     ext4    defaults    defaults